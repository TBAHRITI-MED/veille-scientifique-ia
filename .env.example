# Copie ce fichier en .env (jamais publié : il est dans .gitignore) et remplis ce qu'il te faut.

# --- Résumés en français et score de pertinence (LLM) -------------------------
# Clé de l'API Claude : https://console.anthropic.com → API Keys. Sans elle, l'application
# fonctionne mais sans résumé ni score.
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut le plus rapide et le moins cher de la gamme)
LLM_MODEL=claude-haiku-5-5
# Nombre maximum d'articles analysés par recherche (maîtrise du coût)
LLM_MAX_PAPERS=40
# Profil de recherche par défaut (modifiable ensuite depuis Réglages)
# RESEARCH_PROFILE=Étudiant en Master IA. Centres d'intérêt : federated learning, imagerie médicale, LLM.

# --- Accès ---------------------------------------------------------------------
# Mot de passe demandé par le navigateur. Indispensable dès que l'application est en ligne.
APP_PASSWORD=

# --- Sources (toutes optionnelles : elles augmentent les quotas) --------------
# Ton e-mail, recommandé par OpenAlex et NCBI
CONTACT_EMAIL=
# OpenAlex : clé gratuite depuis ton compte openalex.org
OPENALEX_API_KEY=
# Semantic Scholar : clé gratuite sur demande, https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# PubMed (NCBI) : clé gratuite depuis ton compte NCBI, 10 requêtes/s au lieu de 3
NCBI_API_KEY=
